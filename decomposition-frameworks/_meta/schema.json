{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ivanv33/Various-Files/decomposition-frameworks/_meta/schema.json",
  "title": "Decomposition framework graph (graph.json)",
  "description": "One framework, its slots and relations, and two worked examples (classic, tbpn) with provenance on every node and edge. validate.mjs enforces this plus the cross-field rules in SPEC.md section 11.",
  "type": "object",
  "required": [
    "framework",
    "slots",
    "relations",
    "examples"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "framework": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "category",
        "wikipedia",
        "one_liner"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "category": {
          "type": "string",
          "enum": [
            "01-narrative-and-statement",
            "02-strategic-and-business",
            "03-engineering-and-cognitive",
            "04-sensemaking-and-complex-systems"
          ]
        },
        "wikipedia": {
          "type": "string",
          "pattern": "^https://"
        },
        "one_liner": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/example"
      }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description",
        "typical_provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "typical_provenance": {
          "type": "string",
          "enum": [
            "fact",
            "derived",
            "either",
            "schema"
          ]
        },
        "structural": {
          "type": "boolean",
          "description": "true only for scaffolding slots whose nodes use provenance schema"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "shape": {
          "type": "string",
          "enum": [
            "sphere",
            "box",
            "diamond",
            "cone"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": {
            "const": "supported_by"
          }
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "example": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "summary",
        "source",
        "layout",
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "classic",
            "tbpn"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 40
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/textSource"
            },
            {
              "$ref": "#/$defs/transcriptSource"
            }
          ]
        },
        "why_this_episode": {
          "type": "string",
          "minLength": 40
        },
        "idea_bearing_slot": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "nodes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tbpn"
              }
            }
          },
          "then": {
            "required": [
              "why_this_episode",
              "idea_bearing_slot"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/transcriptSource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "classic"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "$ref": "#/$defs/textSource"
              }
            }
          }
        }
      ]
    },
    "textSource": {
      "type": "object",
      "required": [
        "type",
        "title",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 200,
          "description": "the scenario text that the classic example's fact nodes quote"
        },
        "attribution": {
          "type": "string",
          "description": "origin of the classic example, if it is a known textbook case"
        }
      }
    },
    "transcriptSource": {
      "type": "object",
      "required": [
        "type",
        "file",
        "date",
        "episode_title"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "transcript"
        },
        "file": {
          "type": "string",
          "pattern": "^tbpn-transcripts/transcripts/[0-9]{4}-[0-9]{2}-[0-9]{2}_.+\\.md$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "episode_title": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "force",
            "tree",
            "ring",
            "plane"
          ]
        },
        "root": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "down",
            "right"
          ]
        },
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "$ref": "#/$defs/axis"
            },
            "y": {
              "$ref": "#/$defs/axis"
            }
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "guides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guide"
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "distance": {
              "type": "number",
              "minimum": 10
            }
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pos",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "pos": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 3
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "style": {
                "type": "string",
                "enum": [
                  "caption",
                  "region",
                  "axis"
                ]
              },
              "derived": {
                "type": "boolean",
                "description": "true when the caption explains inferred structure; it then hides with the LLM-derived toggle"
              }
            }
          }
        }
      }
    },
    "axis": {
      "type": "object",
      "required": [
        "label",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "ticks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "label",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "x": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "y": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "guide": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "to": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "style": {
          "type": "string",
          "enum": [
            "solid",
            "dashed"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "slot",
        "label",
        "text",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slot": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "40 characters or fewer preferred; the validator warns above 40"
        },
        "text": {
          "type": "string",
          "minLength": 5
        },
        "provenance": {
          "type": "string",
          "enum": [
            "fact",
            "derived",
            "schema"
          ]
        },
        "source_quote": {
          "type": "string",
          "minLength": 5
        },
        "source_ref": {
          "type": "string"
        },
        "paraphrase": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "pos": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "size": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 4
        },
        "attrs": {
          "type": "object",
          "description": "free-form framework-specific attributes (e.g. stage, polarity)"
        },
        "idea": {
          "type": "string",
          "minLength": 20,
          "description": "derived nodes only: the underserved need, market shift or startup idea this node implies (one sentence)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "fact"
              }
            }
          },
          "then": {
            "required": [
              "source_quote",
              "source_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "confidence",
              "rationale"
            ]
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "relation",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "fact",
            "derived",
            "schema"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 24
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string"
        },
        "source_quote": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "paraphrase": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "confidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "fact"
              }
            }
          },
          "then": {
            "required": [
              "source_quote",
              "source_ref"
            ]
          }
        }
      ]
    }
  }
}
