# Copy to .env (gitignored). `langgraph dev` and the tests load it.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=autoresearch-frameworks
# Where the engine pushes. Local dev: a bare repo, e.g. file:///tmp/autoresearch-origin.git
# Deploy: https://x-access-token:${GITHUB_TOKEN}@github.com/ivanv33/Various-Files.git
GIT_REMOTE=
GITHUB_TOKEN=
GIT_AUTHOR_NAME=autoresearch-bot
GIT_AUTHOR_EMAIL=bot@example.com
# Where clones live inside the container (default /tmp/autoresearch-ws)
AUTORESEARCH_WORKDIR=
