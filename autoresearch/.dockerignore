# Build context for `langgraph build` / `langgraph deploy` is this directory and the generated
# Dockerfile does `ADD . /deps/autoresearch`. Keep secrets, the venv and local scratch out of the image.
.env
.env.*
!.env.example
.venv/
.langgraph_api/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.git/
tests/
dev/
